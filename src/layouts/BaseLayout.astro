---
import "../styles/tokens.css";
import "../styles/typography.css";
import "../styles/glass.css";
import "../styles/sections.css";
import "../styles/a11y.css";

import SkipLink from "../components/atoms/SkipLink.astro";
import AnimatedBackground from "../components/organisms/AnimatedBackground.astro";
import SiteHeader from "../components/organisms/SiteHeader.astro";
import SiteFooter from "../components/organisms/SiteFooter.astro";
import CookieBanner from "../components/organisms/CookieBanner.astro";
import MusicPlayer from "../components/organisms/MusicPlayer.astro";
import NightAtelierOverlay from "../components/organisms/NightAtelierOverlay.astro";
import SocialFixedRail from "../components/organisms/SocialFixedRail.astro";

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  keywords?: string;
  robots?: string;
  ogType?: string;
  ogUrl?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  twitterCard?: "summary" | "summary_large_image";
  twitterTitle?: string;
  twitterDescription?: string;
  bodyClass?: string;
  mainClass?: string;
  isHome?: boolean;
  activeRoute?: "home" | "portfolio" | "services" | "build-log" | "mentions" | "404";
  showHeader?: boolean;
  showSocialRail?: boolean;
  showMusicPlayer?: boolean;
  showNightOverlays?: boolean;
  showCookieBanner?: boolean;
  cookieMoreHref?: string;
  liteBackground?: boolean;
  preloadPortfolioJson?: boolean;
  hasLangPreinitScript?: boolean;
  i18n?: boolean;
}

const {
  title,
  description,
  canonical,
  keywords,
  robots,
  ogType = "website",
  ogUrl,
  ogTitle = title,
  ogDescription = description,
  ogImage = "https://callistoarts.com/assets/images/graphics/Chromatic.jpg",
  ogImageAlt,
  twitterCard = "summary_large_image",
  twitterTitle = ogTitle,
  twitterDescription = ogDescription,
  bodyClass,
  mainClass,
  isHome = false,
  activeRoute = "home",
  showHeader = true,
  showSocialRail = false,
  showMusicPlayer = false,
  showNightOverlays = false,
  showCookieBanner = false,
  cookieMoreHref = "/mentions-legales.html#cookies",
  liteBackground = false,
  preloadPortfolioJson = false,
  hasLangPreinitScript = false,
  i18n = true,
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    {
      hasLangPreinitScript && (
        <script is:inline>
          (function () {
            try {
              var s = localStorage.getItem("callisto-lang");
              document.documentElement.lang = s === "en" ? "en" : "fr";
            } catch (e) {
              document.documentElement.lang = "fr";
            }
          })();
        </script>
      )
    }
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    {isHome && <meta name="author" content="Frédérique Charton, Callisto Arts" />}
    {robots && <meta name="robots" content={robots} />}
    {canonical && <link rel="canonical" href={canonical} />}

    {
      ogUrl && (
        <>
          <meta property="og:type" content={ogType} />
          <meta property="og:site_name" content="Callisto Arts" />
          <meta property="og:locale" content="fr_FR" />
          <meta property="og:locale:alternate" content="en_US" />
          <meta property="og:url" content={ogUrl} />
          <meta property="og:title" content={ogTitle} />
          <meta property="og:description" content={ogDescription} />
          <meta property="og:image" content={ogImage} />
          {isHome && <meta property="og:image:secure_url" content={ogImage} />}
          {isHome && <meta property="og:image:type" content="image/jpeg" />}
          {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
          <meta name="twitter:card" content={twitterCard} />
          <meta name="twitter:url" content={ogUrl} />
          <meta name="twitter:title" content={twitterTitle} />
          <meta name="twitter:description" content={twitterDescription} />
          {twitterCard === "summary_large_image" && (
            <meta name="twitter:image" content={ogImage} />
          )}
          {ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
        </>
      )
    }

    <link rel="icon" type="image/png" href="/assets/images/logo/logo-cllisto.png" />
    <title>{title}</title>

    <slot name="head-extra" />

    {
      preloadPortfolioJson && (
        <link
          rel="preload"
          href="/assets/images/portfolio_images.json?v=13"
          as="fetch"
          type="application/json"
          crossorigin
        />
      )
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <Fragment
      set:html={`<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Inter:wght@300;400;500;600;700&family=Share+Tech+Mono&display=swap" onload="this.onload=null;this.rel='stylesheet'" />`}
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Inter:wght@300;400;500;600;700&family=Share+Tech+Mono&display=swap"
      />
    </noscript>
  </head>

  <body class={bodyClass}>
    <SkipLink i18n={i18n} />
    <AnimatedBackground lite={liteBackground} hasParticlesId={isHome} />

    {
      showHeader && activeRoute !== "404" && (
        <SiteHeader isHome={isHome} activeRoute={activeRoute} />
      )
    }

    {showSocialRail && <SocialFixedRail />}

    <main id="main-content" class={mainClass} tabindex="-1">
      <slot />
    </main>

    <SiteFooter
      isHome={isHome}
      activeRoute={activeRoute}
      hasCookieBanner={showCookieBanner}
      i18n={i18n}
    />

    {showNightOverlays && <NightAtelierOverlay />}
    <slot name="modals" />
    {showMusicPlayer && <MusicPlayer />}
    {showCookieBanner && <CookieBanner moreHref={cookieMoreHref} />}

    <script>
      import { bootSite } from "../scripts/main";

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", () => void bootSite());
      } else {
        void bootSite();
      }
    </script>
  </body>
</html>
