---
import "../../styles/music-player.css";

export interface Props {
  artist?: string;
  trackTitle?: string;
  src?: string;
  initialVolume?: number;
  accentColor?: string;
}

const {
  artist = "Doctor Gekil",
  trackTitle = "Stargaze",
  src = "/assets/musique/Doctor%20Gekil%20-%20Stargaze.mp3",
  initialVolume = 0.45,
  accentColor = "#00ffe0",
} = Astro.props;

const clampedVol = Math.min(1, Math.max(0, initialVolume));
const volPct = Math.round(clampedVol * 100);
---

<aside
  class="music-player"
  data-music-player
  data-label-play="Lire la musique"
  data-label-pause="Mettre la musique en pause"
  data-label-mute="Couper le son"
  data-label-unmute="Rétablir le son"
  data-err-missing="Fichier audio introuvable ou illisible."
  data-err-format="Format audio non pris en charge par ce navigateur."
  data-err-play="Échec de la lecture — réessayez."
  role="region"
  aria-label={`Lecteur audio : musique de fond par ${artist}`}
  data-i18n-aria="musicPlayer.regionAria"
  style={`--mp-accent: ${accentColor}; --mp-seek-pct: 0%; --mp-vol-pct: ${volPct}%;`}
>
  <header class="mp-header">
    <span class="mp-byline" data-i18n="musicPlayer.byline">Musique : {artist}</span>
    <span class="mp-title" title={trackTitle}>{trackTitle}</span>
  </header>

  <div class="mp-main">
    <button
      type="button"
      class="mp-play-btn"
      data-mp-play
      aria-pressed="false"
      aria-label="Lire ou mettre en pause la musique"
      data-i18n-aria="musicPlayer.playAria"
    >
      <span class="mp-icon-wrap mp-icon-play">
        <svg
          class="mp-icon"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M8 5.14v14l11-7-11-7z"></path>
        </svg>
      </span>
      <span class="mp-icon-wrap mp-icon-pause" hidden>
        <svg
          class="mp-icon"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M6 5h4v14H6zm8 0h4v14h-4z"></path>
        </svg>
      </span>
    </button>

    <div class="mp-seek-col">
      <div class="mp-slider-wrap mp-slider-wrap--seek">
        <div class="mp-track" aria-hidden="true">
          <div class="mp-track-fill mp-track-fill--seek"></div>
        </div>
        <input
          type="range"
          class="mp-range mp-range--seek"
          data-mp-seek
          min="0"
          max="100"
          value="0"
          step="0.1"
          aria-label="Position dans la piste"
          data-i18n-aria="musicPlayer.seekAria"
          aria-valuetext="0:00 / 0:00"
          disabled
        />
      </div>

      <div class="mp-time" aria-live="off">
        <span class="mp-time-val" data-mp-current>0:00</span>
        <span class="mp-time-sep" aria-hidden="true">/</span>
        <span class="mp-time-val mp-time-dur" data-mp-duration>0:00</span>
      </div>
    </div>
  </div>

  <div class="mp-vol-row">
    <button
      type="button"
      class="mp-mute-btn"
      data-mp-mute
      aria-pressed="false"
      aria-label="Couper le son"
      title="Couper le son"
    >
      <span class="mp-icon-wrap mp-icon-vol">
        <svg
          class="mp-icon"
          viewBox="0 0 24 24"
          width="14"
          height="14"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
          <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
        </svg>
      </span>
      <span class="mp-icon-wrap mp-icon-muted" hidden>
        <svg
          class="mp-icon"
          viewBox="0 0 24 24"
          width="14"
          height="14"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
          <line x1="22" y1="9" x2="16" y2="15"></line>
          <line x1="16" y1="9" x2="22" y2="15"></line>
        </svg>
      </span>
      <span class="mp-vol-label">Vol.</span>
    </button>

    <div class="mp-slider-wrap mp-slider-wrap--vol">
      <div class="mp-track mp-track--vol" aria-hidden="true">
        <div class="mp-track-fill mp-track-fill--vol"></div>
      </div>
      <input
        type="range"
        class="mp-range mp-range--vol"
        data-mp-vol
        min="0"
        max="1"
        value={String(clampedVol)}
        step="0.01"
        aria-label="Volume"
        aria-valuetext={`${volPct}%`}
      />
    </div>
  </div>

  <audio data-mp-audio preload="metadata" loop>
    <source src={src} type="audio/mpeg" />
  </audio>

  <p class="mp-hint" data-mp-hint role="status" hidden></p>
</aside>
