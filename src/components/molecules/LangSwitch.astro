---

<div
  class="lang-switch"
  role="group"
  aria-label="Choisir la langue du site"
  data-i18n-aria="langSwitch.aria"
>
  <button
    type="button"
    class="lang-switch__btn is-active"
    data-lang="fr"
    aria-pressed="true"
    title="Français"
  >
    FR
  </button>
  <span class="lang-switch__sep" aria-hidden="true">|</span>
  <button
    type="button"
    class="lang-switch__btn"
    data-lang="en"
    aria-pressed="false"
    title="English"
  >
    EN
  </button>
</div>
